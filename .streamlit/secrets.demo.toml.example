# Paste into Streamlit Community Cloud > Advanced settings > Secrets.
# Demo accounts and responses are public examples. Use fictional data only.
FAKE_AI = "1"
DATABASE_URL = "sqlite:///data/app.db"
PILOT_ACCESS_CODE = "replace-with-a-unique-pilot-code"
ADMIN_PASSWORD = "replace-with-a-unique-admin-password"
# Optional: set a specific Monday. If omitted, the demo uses this week’s Monday.
# PROGRAM_START_DATE = "2026-11-02"
APP_TIMEZONE = "Asia/Ho_Chi_Minh"
HOLIDAY_COUNTRIES = "VN"
APP_URL = "https://your-chosen-name.streamlit.app"
