# Never commit actual secrets. Paste configured values into Streamlit's Secrets UI.
FAKE_AI = "0"
OPENAI_API_KEY = "replace-with-your-key"
OPENAI_MODEL = "gpt-4o-mini"
OPENAI_MODEL_STRONG = "gpt-4o"
OPENAI_STT_MODEL = "gpt-4o-mini-transcribe"
OPENAI_STT_MODEL_SHADOWING = "gpt-4o-mini-transcribe"
OPENAI_TTS_MODEL = "gpt-4o-mini-tts"
# Copy the exact pooler host from Supabase > Connect (Singapore project).
# URL-encode special characters in the database password.
DATABASE_URL = "postgresql+psycopg://postgres.PROJECT:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
PILOT_ACCESS_CODE = "replace-with-a-unique-pilot-code"
ADMIN_PASSWORD = "replace-with-a-unique-admin-password"
PROGRAM_START_DATE = "2026-11-09"
APP_TIMEZONE = "Asia/Ho_Chi_Minh"
HOLIDAY_COUNTRIES = "VN"
APP_URL = "https://your-chosen-name.streamlit.app"
PRICE_STRONG_INPUT_PER_1M = "2.5"
PRICE_STRONG_OUTPUT_PER_1M = "10.0"
PRICE_TTS_PER_MINUTE = "0.015"
